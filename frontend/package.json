{
  "name": "schedule-workbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cd .. && conda run --no-capture-output -n gatppo python -m scripts.dev",
    "start": "npm run dev",
    "dev:web": "vite --host 0.0.0.0 --port 8888 --strictPort",
    "dev:api": "cd .. && conda run --no-capture-output -n gatppo python -m uvicorn backend.app:app --host 0.0.0.0 --port 8000",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "echarts": "^5.6.0",
    "element-plus": "^2.9.3",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "vite": "^6.0.7"
  }
}
